{
  "name": "@spark/core",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": [
      "./src/*",
      "./src/index.ts"
    ],
    "./auth/*": [
      "./src/auth/*/index.ts",
      "./src/auth/*"
    ],
    "./auth": "./src/auth/index.ts",
    "./models/*": [
      "./src/models/*/index.ts",
      "./src/models/*"
    ],
    "./models": "./src/models/index.ts",
    "./services/*": [
      "./src/services/*/index.ts",
      "./src/services/*"
    ],
    "./services": "./src/services/index.ts",
    "./utils/*": [
      "./src/utils/*/index.ts",
      "./src/utils/*"
    ],
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "jest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.19",
    "axios": "^1.9.0",
    "dayjs": "^1.11.10",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@turbo/gen": "^1.11.3",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.10.6",
    "@types/react": "~18.3.12",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "axios": "^1.9.0",
    "graphql-request": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "graphql-request": {
      "optional": true
    }
  }
}
