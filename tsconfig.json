{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      // "@spark/core": ["./packages/core/*"],
      "@spark/core/*": ["./packages/core/*"],
      // "@spark/typescript-config": ["./packages/typescript-config/*"],
      "@spark/typescript-config/*": ["./packages/typescript-config/*"],
      // "@spark/eslint-config": ["./packages/eslint-config/*"],
      "@spark/eslint-config/*": ["./packages/eslint-config/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
  ]
}
