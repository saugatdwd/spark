      }
    },
    "owner": "saugatdawadi",
    "android": {
      "package": "com.saugatdawadi.sparkdatingapp.dev"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3893442c-5088-4bba-bd6a-8d49cb928d7e"
    }
  }
